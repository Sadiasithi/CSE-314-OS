+int
+thread_create(void(*fcn)(void*), void* args, void* stack)
+{
+  int i, pid;
+  struct proc *new;
+  struct proc *parent = myproc();
+
+  // Allocate process.
+  if((new = allocproc()) == 0){
+    return -1;
+  }
+
+  // Copy user memory from parent to child.
+  acquire(parent->memlock);
+  if(uvmmirror(parent->pagetable, new->pagetable, parent->sz) < 0){
+    release(parent->memlock);
+    freeproc(new);
+    release(&new->lock);
+    return -1;
+  }
+  new->sz = parent->sz;
+  release(parent->memlock);
+  // Copy saved user registers from parent to child
+  *(new->trapframe) = *(parent->trapframe);  // copy saved user registers.
+
+   // Copy open file descriptors and set cwd
+  for(i = 0; i < NOFILE; i++){ 
+    if(parent->ofile[i]){
+      new->ofile[i] = filedup(parent->ofile[i]);
+    }
+  }
+  new->cwd = idup(parent->cwd);
+
+  safestrcpy(new->name, parent->name, sizeof(parent->name));
+
+  pid = new->pid;
+  new->trapframe->epc = (uint64)fcn; // function pointer for the thread
+  new->trapframe->sp = (uint64)stack + PGSIZE;
+  new->trapframe->sp -= new->trapframe->sp % 16; // align stack pointer to 16-byte boundary
+  new->trapframe->a0 = (uint64)args;
+  new->is_thread = 1;
+  new->trapframe->ra = 0xffffffff; // no return address
+
+  release(&new->lock);
+
+  // Set up parent and memory management information
+  acquire(&wait_lock);
+  new->parent = parent;
+  new->mem_id = parent->mem_id;
+  new->memlock = parent->memlock;
+  release(&wait_lock);
+
+  // Set the new process state to RUNNABLE
+  acquire(&new->lock);
+  new->state = RUNNABLE;
+  release(&new->lock);
+
+  return pid;
+}
+
+
+int
+thread_join(int thread_id)
+{
+  struct proc *thread_proc;
+  struct proc *curr_proc = myproc();
+  int found;
+  int pid;
+  void* chan;
+
+  acquire(&wait_lock);
+  for(;;){
+    found = 0;
+    for(thread_proc = proc; thread_proc < &proc[NPROC]; thread_proc++){
+      if(thread_proc->pid == thread_id && thread_proc->mem_id == curr_proc->mem_id){
+        chan = thread_proc;      
+        acquire(&thread_proc->lock);
+
+        found = 1;
+        if(thread_proc->state == ZOMBIE){
+          pid = thread_proc->pid; // Found one.
+          freeproc(thread_proc);
+          release(&thread_proc->lock);
+          release(&wait_lock);
+          return pid;
+        }
+        release(&thread_proc->lock);
+      }
+    }
+
+    if(!found || killed(curr_proc)){
+      release(&wait_lock);
+      return -1;
+    }
+    sleep(chan, &wait_lock); 
+  }
+}
+
+
+void
+thread_exit(void)
+{
+  struct proc *curr = myproc();
+  if(curr == initproc)
+    panic("init exiting");
+
+  for(int fd = 0; fd < NOFILE; fd++){
+    if(curr->ofile[fd]){
+      fileclose(curr->ofile[fd]);
+    }
+    curr->ofile[fd] = 0;
+  }
+
+  begin_op();
+  iput(curr->cwd);
+  end_op();
+  curr->cwd = 0;
+
+  acquire(&wait_lock);
+  reparent(curr);  // Give any children to init.
+  wakeup(curr); // Parent might be sleeping in wait().
+  acquire(&curr->lock);
+  curr->state = ZOMBIE;
+  release(&wait_lock);
+
+  sched();
+  panic("zombie exit");
+}
