+uint64
+sys_thread_create(void)
+{
+  void (*start)(void*);
+  void *arg, *stack;
+
+  argaddr(0, (uint64*)&start);
+  argaddr(1, (uint64*)&arg);
+  argaddr(2, (uint64*)&stack);
+  return thread_create(start, arg, stack);
+}
+
+uint64
+sys_thread_join(void)
+{
+  int tid;
+  argint(0, &tid);
+  return thread_join(tid);
+}
+
+uint64
+sys_thread_exit(void)
+{
+  thread_exit();
+  return 1;
+}
+
+uint64
+sys_yield(void)
+{
+  yield();
+  return 0;
+}
