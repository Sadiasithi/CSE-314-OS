+uint64
+sys_settickets(void)
+{
+  int tickets;
+  argint(0, &tickets);
+  if(tickets < 1){
+    return -1;
+  }
+ 
+  myproc()->originaltickets = tickets;
+  myproc()->remainingtickets = tickets;
+  //printf("ticket no %d\n", myproc()->originaltickets);
+  return 0;
+}
+
+uint64
+sys_getpinfo(void)
+{
+  uint64 userpstat;
+  argaddr(0, &userpstat);
+  struct pstat kernelpstat;
+
+  for( int i = 0; i < NPROC; i++){
+    acquire(&proc[i].lock);
+    if(proc[i].state != RUNNING && proc[i].state != RUNNABLE){
+      kernelpstat.inuse[i] = 0;
+    }
+    else if(proc[i].state == RUNNING || proc[i].state == RUNNABLE){
+      kernelpstat.inuse[i] = 1;
+    }
+
+    kernelpstat.pid[i] = proc[i].pid;
+    kernelpstat.inQ[i] = proc[i].inQ;
+    kernelpstat.waiting_time[i] = proc[i].waitingtime;
+    kernelpstat.running_time[i] = proc[i].runningtime;
+    kernelpstat.times_scheduled[i] = proc[i].timesscheduled;
+    kernelpstat.tickets_original[i] = proc[i].originaltickets;
+    kernelpstat.tickets_current[i] = proc[i].remainingtickets;
+    kernelpstat.queue_ticks[i][0] = proc[i].ticksQ0;
+    kernelpstat.queue_ticks[i][1] = proc[i].ticksQ1;
+    
+    release(&proc[i].lock);
+  }
+
+  if(copyout(myproc()->pagetable, userpstat, (char *)&kernelpstat, sizeof(kernelpstat)) < 0){
+    return -1;
+  }
+  return 0;
+}
