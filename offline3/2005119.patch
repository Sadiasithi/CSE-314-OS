diff --git a/kernel/random.c b/kernel/random.c
new file mode 100644
index 0000000..07af399
--- /dev/null
+++ b/kernel/random.c
@@ -0,0 +1,22 @@
+#include "types.h"
+
+#define RAND_A 1103515245
+#define RAND_C 12345
+#define RAND_M 0x7fffffff // 2^31 - 1 (a large prime)
+
+static unsigned int state = 12345;  
+
+uint random(void) { // Pseudo-random number generator using LCG
+    state = (RAND_A * state + RAND_C) & RAND_M;
+    return state;
+}
+
+int randomrange(int low, int high) {
+    if (high < low) {
+        int tmp = low;
+        low = high;
+        high = tmp;
+    }
+    int range = high - low + 1;
+    return random() % range + low;
+}
