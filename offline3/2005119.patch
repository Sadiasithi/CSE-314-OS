+++ b/user/dummyproc.c
@@ -0,0 +1,38 @@
+#include "kernel/types.h"
+#include "user.h"
+
+int main(int argc, char *argv[]){
+    if (argc != 3){
+        printf("Usage : dummyproc <numoftickets> <noofiteration>\n");
+        exit(1);
+    }
+    
+    int num_tickets = atoi(argv[1]);
+    int num_iterations = atoi(argv[2]);
+
+    if(settickets(num_tickets) == -1){
+        printf("Error in settickets\n");
+        exit(1);
+    }
+
+    //creating childs of the parent process
+    for (int i = 0; i < 4; i++) {
+        int pid = fork();
+        if (pid == 0) { // Child process
+            for (int iter = 0; iter < num_iterations; iter++) {
+                for (volatile int count = 0; count < 1000000000; count++) {
+                    if (count % 20000000 == 0) {
+                        sleep(10); 
+                    }
+                }
+            }
+            exit(0); 
+        }
+    }
+    
+    for(int i = 0; i < num_iterations; i++) {//will do nothing      
+    }
+    
+    printf("Parent process with pid %d has finished\n", getpid());
+    return 0;
+}
